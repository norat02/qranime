    <script>
        let qrCode = null;
        let uploadedImage = null;
        
        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const header = content.previousElementSibling;
            const icon = header.querySelector('.accordion-icon');
            
            content.classList.toggle('hidden');
            icon.classList.toggle('active');
            
            const allContents = document.querySelectorAll('.accordion-content');
            const allIcons = document.querySelectorAll('.accordion-icon');
            
            allContents.forEach((item, index) => {
                if (item.id !== id && !item.classList.contains('hidden')) {
                    item.classList.add('hidden');
                    allIcons[index].classList.remove('active');
                }
            });
        }
        
        document.getElementById('qrSize').addEventListener('input', function() {
            document.getElementById('sizeValue').textContent = this.value + 'px';
        });
        
        document.getElementById('qrMargin').addEventListener('input', function() {
            document.getElementById('marginValue').textContent = this.value + 'px';
        });
        
        document.getElementById('imageSize').addEventListener('input', function() {
            document.getElementById('imageSizeValue').textContent = this.value + '%';
        });
        
        document.getElementById('imageMargin').addEventListener('input', function() {
            document.getElementById('imageMarginValue').textContent = this.value + 'px';
        });
        
        document.getElementById('dotsGradientRotation').addEventListener('input', function() {
            document.getElementById('dotsRotationValue').textContent = this.value + '°';
        });
        
        document.getElementById('bgGradientRotation').addEventListener('input', function() {
            document.getElementById('bgRotationValue').textContent = this.value + '°';
        });

        document.getElementById('dotsColorType').addEventListener('change', function() {
            const gradientOptions = document.getElementById('dotsGradientOptions');
            gradientOptions.classList.toggle('hidden', this.value === 'single');
            generateVietQR();
        });
        
        document.getElementById('bgColorType').addEventListener('change', function() {
            const gradientOptions = document.getElementById('bgGradientOptions');
            gradientOptions.classList.toggle('hidden', this.value === 'single');
            generateVietQR();
        });

        document.getElementById('qrImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const imageInfo = document.getElementById('imageInfo');
            const deleteBtn = document.getElementById('deleteImage');
            
            if (file) {
                uploadedImage = URL.createObjectURL(file);
                imageInfo.textContent = `Đã upload: ${file.name} (${(file.size/1024).toFixed(1)}KB)`;
                deleteBtn.classList.remove('hidden');
                generateVietQR();
            } else {
                deleteImage();
            }
        });

        async function generateVietQR() {
            const formData = {
                acquierID: document.getElementById('acquierID').value,
                consumerID: document.getElementById('consumerID').value,
                amount: document.getElementById('amount').value,
                additionalData: document.getElementById('additionalData').value
            };

            try {
                const response = await fetch('/generate-qr', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();
                
                if (result.success) {
                    generateStyledQR(result.qrData);
                } else {
                    alert('Lỗi: ' + result.error);
                }
            } catch (error) {
                alert('Lỗi kết nối: ' + error.message);
            }
        }

        ['acquierID', 'consumerID', 'amount', 'additionalData'].forEach(id => {
            document.getElementById(id).addEventListener('change', generateVietQR);
            document.getElementById(id).addEventListener('input', generateVietQR);
        });

        generateVietQR();

        function generateStyledQR(qrData) {
            const container = document.getElementById('qrContainer');
            const options = getQROptions(qrData);
            
            container.innerHTML = '';
            qrCode = new QRCodeStyling(options);
            qrCode.append(container);
        }

        function getQROptions(qrData) {
            const size = parseInt(document.getElementById('qrSize').value);
            const margin = parseInt(document.getElementById('qrMargin').value);
            const dotsType = document.getElementById('dotsType').value;
            const dotsColorType = document.getElementById('dotsColorType').value;
            const cornersSquareType = document.getElementById('cornersSquareType').value;
            const cornersDotType = document.getElementById('cornersDotType').value;
            const bgColorType = document.getElementById('bgColorType').value;
            const imageSize = parseInt(document.getElementById('imageSize').value) / 100;
            const imageMargin = parseInt(document.getElementById('imageMargin').value);
            const hideBackgroundDots = document.getElementById('hideBackgroundDots').checked;

            let dotsOptions = {
                type: dotsType
            };

            if (dotsColorType === 'single') {
                dotsOptions.color = document.getElementById('dotsColor').value;
            } else {
                dotsOptions.gradient = {
                    type: document.getElementById('dotsGradientType').value,
                    rotation: parseInt(document.getElementById('dotsGradientRotation').value) * Math.PI / 180,
                    colorStops: [
                        { offset: 0, color: document.getElementById('dotsGradientColor1').value },
                        { offset: 1, color: document.getElementById('dotsGradientColor2').value }
                    ]
                };
            }

            let backgroundOptions = {};
            if (bgColorType === 'single') {
                backgroundOptions.color = document.getElementById('bgColor').value;
            } else {
                backgroundOptions.gradient = {
                    type: document.getElementById('bgGradientType').value,
                    rotation: parseInt(document.getElementById('bgGradientRotation').value) * Math.PI / 180,
                    colorStops: [
                        { offset: 0, color: document.getElementById('bgGradientColor1').value },
                        { offset: 1, color: document.getElementById('bgGradientColor2').value }
                    ]
                };
            }

            const cornersSquareOptions = {
                type: cornersSquareType,
                color: document.getElementById('cornersSquareColor').value
            };

            const cornersDotOptions = {
                type: cornersDotType,
                color: document.getElementById('cornersDotColor').value
            };

            let imageOptions = {};
            if (uploadedImage) {
                imageOptions = {
                    image: uploadedImage,
                    imageSize: imageSize,
                    margin: imageMargin,
                    hideBackgroundDots: hideBackgroundDots,
                    crossOrigin: "anonymous"
                };
            }

            const options = {
                width: size,
                height: size,
                type: "canvas",
                data: qrData,
                margin: margin,
                dotsOptions: dotsOptions,
                backgroundOptions: backgroundOptions,
                cornersSquareOptions: cornersSquareOptions,
                cornersDotOptions: cornersDotOptions,
                imageOptions: imageOptions
            };

            if (uploadedImage) {
                options.image = uploadedImage;
            }

            return options;
        }





        const controls = [
            'qrSize', 'qrMargin', 'dotsType', 'dotsColor', 'dotsColorType',
            'dotsGradientType', 'dotsGradientColor1', 'dotsGradientColor2', 'dotsGradientRotation',
            'cornersSquareType', 'cornersSquareColor', 'cornersDotType', 'cornersDotColor',
            'bgColorType', 'bgColor', 'bgGradientType', 'bgGradientColor1', 'bgGradientColor2', 'bgGradientRotation',
            'imageSize', 'imageMargin', 'hideBackgroundDots'
        ];

        const imageControls = ['imageSize', 'imageMargin', 'hideBackgroundDots'];

        controls.forEach(controlId => {
            const element = document.getElementById(controlId);
            if (element) {
                element.addEventListener('change', generateVietQR);
                element.addEventListener('input', generateVietQR);
            }
        });

        imageControls.forEach(controlId => {
            const element = document.getElementById(controlId);
            if (element) {
                element.addEventListener('change', generateVietQR);
                element.addEventListener('input', generateVietQR);
            }
        });

        function deleteImage() {
            if (uploadedImage) {
                URL.revokeObjectURL(uploadedImage);
            }
            uploadedImage = null;
            document.getElementById('imageInfo').textContent = '';
            document.getElementById('deleteImage').classList.add('hidden');
            document.getElementById('qrImage').value = '';
            generateVietQR();
        }
        
        $(document).ready(function() {
            $('.select2-bank').select2({
                placeholder: 'Chọn ngân hàng...',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() {
                        return "Không tìm thấy ngân hàng";
                    }
                }
            }).on('change', function() {
                generateVietQR();
            });
        });
    </script>
</body>
</html> 